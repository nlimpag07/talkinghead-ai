# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ─── Database ───────────────────────────────────────────────────────────────
# Two URLs because production puts a connection pooler in front of Postgres and
# the pooler cannot run DDL. Runtime queries go through DATABASE_URL; the Prisma
# CLI (migrate, db execute, studio) uses DIRECT_URL.
#
# LOCAL (docker compose up -d). No pooler, so both point at the same server.
# Host port is 5433 to avoid colliding with a local Postgres install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/voice_orb?sslmode=disable"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/voice_orb?sslmode=disable"

# MANAGED (Supabase). Transaction pooler on 6543, direct on 5432.
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Optional. Set only if `migrate dev` fails to create its own shadow database.
# SHADOW_DATABASE_URL=""

# Connections per instance. 1 on serverless, where every function instance
# opens its own pool against a shared pooler. Higher locally.
PRISMA_POOL_MAX="5"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# ─── Gemini (voice) ─────────────────────────────────────────────────────────
# Free key from https://aistudio.google.com/apikey — no card required. The Live
# API native-audio models are free of charge on the free tier.
GEMINI_API_KEY=""
GEMINI_LIVE_MODEL="gemini-3.1-flash-live-preview"
# Prebuilt Gemini Live voice. Overridden by the `voice` row in Setting.
# Deeper male voices suit the persona: Charon, Orus, Fenrir.
GEMINI_VOICE="Charon"
# Accent/pronunciation, BCP-47. Changes how the voice speaks, not which voice.
# fil-PH suits Taglish; try en-PH if Filipino pronunciation over-applies to the
# English half. Others: en-US, en-GB, en-AU.
GEMINI_LANGUAGE_CODE="fil-PH"

# ─── OpenAI (unused — voice migrated to Gemini) ─────────────────────────────
# Optional. services/openai/realtime.ts is retained for a switch back, and the
# Azure OpenAI route uses the same API shape.
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-mini"

# Generate with: openssl rand -base64 32
IP_HASH_SALT=""

# ─── Cost controls (server-enforced at creation; duration is best-effort) ───
SESSION_MAX_SECONDS="600"
MAX_SESSIONS_PER_IP="2"

# ─── Retrieval ──────────────────────────────────────────────────────────────
KNOWLEDGE_TOP_K="5"
# Cosine similarity floor. Below this a passage is dropped rather than handed
# to the model. Raise it if the assistant answers confidently from unrelated
# documents; lower it if it says "wala ako niyan" to things you know are indexed.
KNOWLEDGE_MIN_SCORE="0.3"

# ─── Supabase Storage (slice 6) ─────────────────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="knowledge"

# ─── Rate limiting (slice 7) ────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
